# Database (Supabase)
# IMPORTANT: use the IPv4 connection POOLER, not the direct db.<ref>.supabase.co
# host — that host is IPv6-only and unreachable from IPv4-only environments like
# Vercel serverless (causes Prisma P1001 "Can't reach database server").
#
# Copy BOTH complete URIs from your project's Supabase Dashboard -> Connect.
# Do not construct the hostname from the region: aws-0 / aws-1 is a cluster
# index, and guessing it causes "tenant/user ... not found" during OAuth login.
# Replace only the password placeholder; percent-encode reserved characters.
# Runtime app -> transaction pooler, port 6543 (serverless-friendly):
DATABASE_URL="postgresql://postgres.<project-ref>:<encoded-password>@<pooler-host-from-connect>:6543/postgres"
# Migrations -> session pooler, port 5432 (supports DDL / advisory locks):
DIRECT_URL="postgresql://postgres.<project-ref>:<encoded-password>@<pooler-host-from-connect>:5432/postgres"
# Optional project CA certificate (PEM text) to verify database TLS.
# Leave unset to retain the existing encrypted, unverified connection behavior.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----
# ...paste the PEM certificate on multiple lines...
# -----END CERTIFICATE-----"

# NextAuth
# In Vercel Production, use your canonical https:// website origin instead.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# GitHub OAuth
GITHUB_ID="your-github-client-id"
GITHUB_SECRET="your-github-client-secret"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
